generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id                     String         @id @default(uuid())
  email                  String         @unique
  passwordHash           String
  fullName               String
  phone                  String?
  storeName              String?
  storeLink              String?        @unique
  storeDescription       String?
  logoUrl                String?
  isOnline               Boolean        @default(true)
  plan                   String         @default("FREE")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  accountName            String?
  accountNumber          String?
  bankName               String?
  bannerDiscount         String?
  bannerImage            String?
  bannerSubtitle         String?
  bannerTitle            String?
  businessAddress        String?
  businessName           String?
  cacNumber              String?
  deliveryFee            Decimal?       @db.Decimal(10, 2)
  deliveryTime           String?        @default("2-3 Business Days")
  facebook               String?
  hasBanner              Boolean        @default(false)
  instagram              String?
  showBusinessDetails    Boolean        @default(false)
  storeCategory          String?
  themeColor             String         @default("#044e3b")
  twitter                String?
  whatsapp               String?
  enableSecondaryBanner  Boolean        @default(false)
  enableSlideshow        Boolean        @default(false)
  secondaryBannerDesc    String?
  secondaryBannerImage   String?
  secondaryBannerTitle   String?
  slideshowImages        String[]
  snapchat               String?
  tiktok                 String?
  paystackSubaccountCode String?
  bankCode               String?
  categories             Category[]
  customers              Customer[]
  notifications          Notification[]
  orders                 Order[]
  products               Product[]
}

model Category {
  id        String   @id @default(uuid())
  vendorId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, name])
}

model Product {
  id             String      @id @default(uuid())
  vendorId       String
  name           String
  description    String?
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  stockQuantity  Int         @default(0)
  category       String
  status         String      @default("ACTIVE")
  imageUrls      String[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  orderItems     OrderItem[]
  vendor         Vendor      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Customer {
  id        String   @id @default(uuid())
  vendorId  String
  fullName  String
  email     String?
  phone     String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders    Order[]
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  vendorId         String
  customerId       String?
  totalAmount      Decimal     @db.Decimal(10, 2)
  deliveryFee      Decimal     @default(0.00) @db.Decimal(10, 2)
  status           String      @default("PENDING")
  paymentMethod    String?
  paymentStatus    String      @default("UNPAID")
  customerNote     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  customerEmail    String
  customerName     String
  customerPhone    String
  deliveryMethod   String      @default("negotiated")
  shippingAddress  Json
  subtotal         Decimal     @db.Decimal(10, 2)
  paymentReference String?
  channel          String      @default("ONLINE")
  customer         Customer?   @relation(fields: [customerId], references: [id])
  vendor           Vendor      @relation(fields: [vendorId], references: [id])
  items            OrderItem[]
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  priceAtPurchase Decimal @db.Decimal(10, 2)
  color           String?
  image           String?
  name            String
  size            String?
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  vendorId  String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}
